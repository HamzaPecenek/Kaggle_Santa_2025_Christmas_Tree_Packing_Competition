{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":119106,"databundleVersionId":14485445,"sourceType":"competition"}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import math\nimport random\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom shapely import affinity\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\nfrom shapely.strtree import STRtree\nfrom tqdm.notebook import tqdm\n\n# We use standard floats for the physics engine to be fast.\n# We will convert to the required high-precision format only at the very end.\nSCALE = 1e15 \nprint(\"Libraries loaded. Ready for Crystal Packing.\")\n\n\n\nclass ChristmasTree:\n    # --- Definition of the Polygon (Same as Getting Started) ---\n    trunk_w = 0.15; trunk_h = 0.2; base_w = 0.7; mid_w = 0.4; top_w = 0.25\n    tip_y = 0.8; tier_1_y = 0.5; tier_2_y = 0.25; base_y = 0.0; trunk_bottom_y = -trunk_h\n    \n    BASE_VERTICES = [\n        (0.0, tip_y),\n        (top_w/2, tier_1_y), (top_w/4, tier_1_y),\n        (mid_w/2, tier_2_y), (mid_w/4, tier_2_y),\n        (base_w/2, base_y),\n        (trunk_w/2, base_y), (trunk_w/2, trunk_bottom_y),\n        (-trunk_w/2, trunk_bottom_y), (-trunk_w/2, base_y),\n        (-base_w/2, base_y),\n        (-mid_w/4, tier_2_y), (-mid_w/2, tier_2_y),\n        (-top_w/4, tier_1_y), (-top_w/2, tier_1_y)\n    ]\n    BASE_POLY = Polygon(BASE_VERTICES)\n\n    def __init__(self, x=0, y=0, deg=0):\n        self.x = x\n        self.y = y\n        self.deg = deg\n        self.poly = None\n        self.update_polygon()\n\n    def update_polygon(self):\n        # Rotating at the origin then translating is faster/cleaner\n        if self.deg == 0:\n            rotated = self.BASE_POLY\n        else:\n            rotated = affinity.rotate(self.BASE_POLY, self.deg, origin=(0, 0))\n        self.poly = affinity.translate(rotated, self.x, self.y)\n    \n    def set_pos(self, x, y, deg):\n        self.x = x\n        self.y = y\n        self.deg = deg\n        self.update_polygon()\n        \n    def copy(self):\n        return ChristmasTree(self.x, self.y, self.deg)\n\n\n\n\ndef find_optimal_pair():\n    \"\"\"\n    Finds the tightest interlocking position for two trees.\n    We assume one is upright (0 deg) and one is inverted (180 deg) \n    because the shape is roughly triangular.\n    \"\"\"\n    t1 = ChristmasTree(0, 0, 0)\n    \n    best_pair = None\n    min_area = float('inf')\n    \n    # We scan a grid of positions for the second tree (inverted)\n    # The tree is approx 0.7 wide and 1.0 high. \n    # We search relative to t1.\n    \n    search_resolution = 0.05 # Coarse search\n    best_dx, best_dy = 0, 0\n    \n    # Grid search for rough locking\n    for dx in np.arange(-0.8, 0.8, search_resolution):\n        for dy in np.arange(-1.0, 1.0, search_resolution):\n            t2 = ChristmasTree(dx, dy, 180)\n            \n            # Fast overlap check\n            if t1.poly.intersects(t2.poly) and not t1.poly.touches(t2.poly):\n                continue\n                \n            # Valid pair? Measure box area\n            minx, miny, maxx, maxy = unary_union([t1.poly, t2.poly]).bounds\n            side = max(maxx-minx, maxy-miny)\n            area = side**2\n            \n            if area < min_area:\n                min_area = area\n                best_dx, best_dy = dx, dy\n    \n    # Fine tune optimization (Hill Climbing) around the best spot\n    current_dx, current_dy = best_dx, best_dy\n    step = 0.01\n    for _ in range(50):\n        found_better = False\n        for mx in [-step, 0, step]:\n            for my in [-step, 0, step]:\n                if mx == 0 and my == 0: continue\n                \n                nx, ny = current_dx + mx, current_dy + my\n                t2 = ChristmasTree(nx, ny, 180)\n                if t1.poly.intersects(t2.poly) and not t1.poly.touches(t2.poly):\n                    continue\n                    \n                minx, miny, maxx, maxy = unary_union([t1.poly, t2.poly]).bounds\n                side = max(maxx-minx, maxy-miny)\n                area = side**2\n                \n                if area < min_area:\n                    min_area = area\n                    current_dx, current_dy = nx, ny\n                    found_better = True\n        if not found_better:\n            step /= 2 # Increase precision\n            \n    print(f\"Optimal Interlock Found: dx={current_dx:.4f}, dy={current_dy:.4f}\")\n    return current_dx, current_dy\n\n# Calculate the offsets once\n# Usually a tree upside down fits into the \"shoulder\" of the upright one\nPAIR_DX, PAIR_DY = find_optimal_pair()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T10:05:51.887099Z","iopub.execute_input":"2025-11-25T10:05:51.888197Z","iopub.status.idle":"2025-11-25T10:05:52.522855Z","shell.execute_reply.started":"2025-11-25T10:05:51.888146Z","shell.execute_reply":"2025-11-25T10:05:52.521709Z"}},"outputs":[{"name":"stdout","text":"Libraries loaded. Ready for Crystal Packing.\nOptimal Interlock Found: dx=-0.3946, dy=0.6929\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"def generate_lattice_layout(n):\n    \"\"\"\n    Generates a dense grid of n trees.\n    We try different aspect ratios (rows vs cols) to find the most 'square' result.\n    \"\"\"\n    \n    best_layout = []\n    best_side = float('inf')\n    \n    # The dimensions of our \"Unit Cell\" (one up, one down)\n    # Based on our pair optimization, we know the shift vector.\n    \n    # We treat the trees as having effective width/height roughly 0.7 and 1.0\n    # But packed tighter.\n    eff_w = 0.7 # Approximation, will be compacted later\n    eff_h = 1.0\n    \n    # Try different grid shapes (rows x cols) that fit roughly N trees\n    # We want a square-ish final bounding box.\n    \n    root_n = int(math.sqrt(n))\n    # We search aspect ratios around the square root\n    min_rows = max(1, root_n - 5)\n    max_rows = root_n + 5\n    \n    for rows in range(min_rows, max_rows + 1):\n        cols = math.ceil(n / rows)\n        \n        current_trees = []\n        \n        for r in range(rows):\n            for c in range(cols):\n                if len(current_trees) >= n:\n                    break\n                    \n                # Base Position in Grid\n                # We stagger rows slightly to fit the triangular tips?\n                # For now, simple grid of pairs.\n                \n                x_base = c * 0.7 # Spacing width\n                y_base = r * 1.0 # Spacing height\n                \n                # We alternate Up/Down in a checkerboard or linear pattern\n                # Pattern: UP, DOWN, UP, DOWN...\n                \n                is_even = (len(current_trees) % 2 == 0)\n                \n                if is_even:\n                    # Place Upright\n                    # We might need to adjust spacing based on row/col\n                    t = ChristmasTree(x_base, y_base, 0)\n                else:\n                    # Place Inverted (using the optimal offset relative to the previous even tree)\n                    # This effectively pairs them up\n                    t = ChristmasTree(x_base + PAIR_DX, y_base + PAIR_DY, 180)\n                \n                current_trees.append(t)\n        \n        # Center the cluster\n        polys = [t.poly for t in current_trees]\n        minx, miny, maxx, maxy = unary_union(polys).bounds\n        w, h = maxx-minx, maxy-miny\n        side = max(w, h)\n        \n        if side < best_side:\n            best_side = side\n            best_layout = current_trees\n            \n    return best_layout, best_side\n\n\n\ndef squeeze_layout(trees, iterations=100):\n    \"\"\"\n    Takes a layout and greedily pushes trees towards the center.\n    Much faster than full Simulated Annealing for large N.\n    \"\"\"\n    # 1. Calculate Bounds Center\n    polys = [t.poly for t in trees]\n    minx, miny, maxx, maxy = unary_union(polys).bounds\n    cx, cy = (minx+maxx)/2, (miny+maxy)/2\n    \n    # 2. Iterative Squeeze\n    step_size = 0.1\n    \n    for _ in range(iterations):\n        moved_any = False\n        \n        # Randomize order to prevent bias\n        indices = list(range(len(trees)))\n        random.shuffle(indices)\n        \n        for i in indices:\n            t = trees[i]\n            \n            # Vector to center\n            dx = cx - t.x\n            dy = cy - t.y\n            dist = math.hypot(dx, dy)\n            if dist < 1e-6: continue\n            \n            # Normalize and scale\n            move_x = (dx / dist) * step_size\n            move_y = (dy / dist) * step_size\n            \n            # Try moving\n            orig_x, orig_y = t.x, t.y\n            t.set_pos(orig_x + move_x, orig_y + move_y, t.deg)\n            \n            # Check Collision\n            # We construct a list of OTHERS\n            # Note: For N=200 this is slow O(N^2). \n            # In a real contest, use STRtree. Here we rely on the lattice being mostly good.\n            collision = False\n            for j, other in enumerate(trees):\n                if i == j: continue\n                if t.poly.intersects(other.poly) and not t.poly.touches(other.poly):\n                    collision = True\n                    break\n            \n            if collision:\n                # Revert\n                t.set_pos(orig_x, orig_y, t.deg)\n            else:\n                moved_any = True\n        \n        if not moved_any:\n            step_size *= 0.5 # Refine precision\n            if step_size < 0.001: break\n            \n    # Final cleanup: Recenter\n    polys = [t.poly for t in trees]\n    minx, miny, maxx, maxy = unary_union(polys).bounds\n    width, height = maxx-minx, maxy-miny\n    \n    return trees, max(width, height)\n\n\n\nall_solutions = []\ntotal_score = 0\n\nprint(\"Starting solution generation for N=1 to 200...\")\n\nfor n in tqdm(range(1, 201)):\n    \n    # Strategy 1: Lattice Generation (Best for N > 5)\n    trees, side = generate_lattice_layout(n)\n    \n    # Strategy 2: Simple refinement (Squeeze gaps)\n    # We only run this for smaller N to save time, or run with few iterations\n    if n < 50:\n        trees, side = squeeze_layout(trees, iterations=50)\n    else:\n        # For large N, the lattice is usually already very good.\n        # Just simple centering.\n        trees, side = squeeze_layout(trees, iterations=10)\n\n    # Calculate Score Component for this N\n    score_component = (side**2) / n\n    total_score += score_component\n    \n    # Store Data\n    for i, t in enumerate(trees):\n        all_solutions.append({\n            'id': f\"{n:03d}_{i}\",\n            'x': t.x,\n            'y': t.y,\n            'deg': t.deg\n        })\n\nprint(f\"Finished! Final Approximation Score: {total_score:.4f}\")\n\n\n\n\n# Create DataFrame\ndf = pd.DataFrame(all_solutions)\n\n# High Precision Formatter (Adding 's' and ensuring decimals)\ndef format_submission(val):\n    return f\"s{val:.10f}\"\n\nsubmission = pd.DataFrame()\nsubmission['id'] = df['id']\nsubmission['x'] = df['x'].apply(format_submission)\nsubmission['y'] = df['y'].apply(format_submission)\nsubmission['deg'] = df['deg'].apply(format_submission)\n\nsubmission.to_csv('submission.csv', index=False)\nprint(\"Saved 'submission.csv'. Ready to submit.\")\nprint(submission.head())\n\n# --- Visualization check for N=50 (to verify gaps are gone) ---\n# Filter N=50\nn50_trees = df[df['id'].str.startswith('050_')]\nif not n50_trees.empty:\n    plt.figure(figsize=(8,8))\n    for _, row in n50_trees.iterrows():\n        t = ChristmasTree(row['x'], row['y'], row['deg'])\n        x, y = t.poly.exterior.xy\n        plt.fill(x, y, alpha=0.6)\n        plt.plot(x, y, 'k-', linewidth=0.5)\n    plt.axis('equal')\n    plt.title(\"Improved Packing for N=50 (Lattice Strategy)\")\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T10:19:51.871092Z","iopub.execute_input":"2025-11-25T10:19:51.871463Z"}},"outputs":[{"name":"stdout","text":"Starting solution generation for N=1 to 200...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/200 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"24a7b3885b624af59ee0d45886dac488"}},"metadata":{}}],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}