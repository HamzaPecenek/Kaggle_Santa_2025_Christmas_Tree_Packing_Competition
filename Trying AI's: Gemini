{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":119106,"databundleVersionId":14485445,"sourceType":"competition"}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport shapely\nfrom shapely.geometry import Polygon, Point, box\nfrom shapely import affinity\nimport random\nimport math\nfrom tqdm import tqdm\n\n# -----------------------------------------------------------------------------\n# 1. CONFIGURATION & GEOMETRY DEFINITION\n# -----------------------------------------------------------------------------\n# Based on the \"Getting Started\" notebook variables found in the challenge details:\n# trunk_w=0.15, trunk_h=0.2, base_w=0.7, mid_w=0.4, top_w=0.25\n# tip_y=0.8, tier_1_y=0.5, tier_2_y=0.25, base_y=0.0, trunk_bottom_y=-0.2\n\n# Define the vertices of the tree (Continuous Polygon Model)\n# Note: Coordinates are relative to the center/anchor which we will manage.\n# The competition defines (x,y) as the \"center of the top of the trunk\".\n# Based on the geometry, the top of the trunk is at (0, 0) if we align base_y=0.\n\ntree_vertices = [\n    (0.0, 0.8),          # Tip\n    (0.125, 0.5),        # Top Tier Right (top_w/2)\n    (0.2, 0.25),         # Mid Tier Right (mid_w/2)\n    (0.35, 0.0),         # Base Right (base_w/2)\n    (0.075, 0.0),        # Trunk Top Right (trunk_w/2)\n    (0.075, -0.2),       # Trunk Bottom Right\n    (-0.075, -0.2),      # Trunk Bottom Left\n    (-0.075, 0.0),       # Trunk Top Left\n    (-0.35, 0.0),        # Base Left\n    (-0.2, 0.25),        # Mid Tier Left\n    (-0.125, 0.5)        # Top Tier Left\n]\n\nBASE_TREE_POLY = Polygon(tree_vertices)\n\ndef get_tree_polygon(x, y, deg):\n    \"\"\"\n    Returns a shapely Polygon for a tree at (x,y) rotated by deg.\n    \"\"\"\n    # Rotate around (0,0) first (which is the top of the trunk anchor)\n    # Note: Shapely rotates counter-clockwise.\n    rotated_poly = affinity.rotate(BASE_TREE_POLY, deg, origin=(0,0), use_radians=False)\n    # Translate to position\n    translated_poly = affinity.translate(rotated_poly, xoff=x, yoff=y)\n    return translated_poly\n\n# -----------------------------------------------------------------------------\n# 2. VISUALIZATION HELPER\n# -----------------------------------------------------------------------------\ndef plot_packing(trees, title=\"Tree Packing\"):\n    \"\"\"\n    Plots a list of tree dictionaries {'x':, 'y':, 'deg':}.\n    \"\"\"\n    fig, ax = plt.subplots(figsize=(8, 8))\n    \n    min_x, max_x = float('inf'), float('-inf')\n    min_y, max_y = float('inf'), float('-inf')\n    \n    polys = []\n    for tree in trees:\n        p = get_tree_polygon(tree['x'], tree['y'], tree['deg'])\n        polys.append(p)\n        bounds = p.bounds\n        min_x = min(min_x, bounds[0])\n        min_y = min(min_y, bounds[1])\n        max_x = max(max_x, bounds[2])\n        max_y = max(max_y, bounds[3])\n        \n        x, y = p.exterior.xy\n        ax.fill(x, y, alpha=0.5, fc='green', ec='darkgreen')\n        # Plot anchor point\n        ax.plot(tree['x'], tree['y'], 'ro', markersize=2)\n\n    # Calculate bounding box side s\n    width = max_x - min_x\n    height = max_y - min_y\n    s = max(width, height)\n    \n    # Draw bounding box (centered on the trees)\n    center_x = (min_x + max_x) / 2\n    center_y = (min_y + max_y) / 2\n    rect = plt.Rectangle((center_x - s/2, center_y - s/2), s, s, \n                         linewidth=2, edgecolor='blue', facecolor='none', linestyle='--')\n    ax.add_patch(rect)\n    \n    ax.set_aspect('equal')\n    ax.set_title(f\"{title}\\nMetric Score Contribution: {s**2 / len(trees):.4f}\")\n    plt.grid(True, alpha=0.3)\n    plt.show()\n\n# Preview the tree shape\nprint(\"Visualizing single tree shape...\")\nplot_packing([{'x': 0, 'y': 0, 'deg': 0}], \"Single Tree Reference\")\n\n# -----------------------------------------------------------------------------\n# 3. OPTIMIZATION ALGORITHM (GREEDY HEURISTIC)\n# -----------------------------------------------------------------------------\ndef solve_for_n(n_trees, trials=50):\n    \"\"\"\n    Greedy packing algorithm for n_trees.\n    \n    Strategy:\n    1. Place 1st tree at (0,0).\n    2. For each subsequent tree:\n       - Try 'trials' random positions/rotations near the current cluster.\n       - Filter out collisions.\n       - Pick the one that minimizes the max dimension (keeps it square).\n    \"\"\"\n    # Initialize with first tree\n    placed_trees = [{'x': 0.0, 'y': 0.0, 'deg': 0.0}]\n    placed_polys = [get_tree_polygon(0, 0, 0)]\n    \n    # Current bounds\n    curr_min_x, curr_max_x = -0.35, 0.35  # Approx base width\n    curr_min_y, curr_max_y = -0.2, 0.8    # Approx height\n    \n    for i in range(1, n_trees):\n        best_move = None\n        best_metric = float('inf')\n        \n        # Search radius expands slightly with more trees\n        radius = math.sqrt(i) * 0.5\n        \n        # Try random candidates\n        for _ in range(trials):\n            # Heuristic: bias towards center but allow spread\n            angle_rad = random.uniform(0, 2 * math.pi)\n            dist = random.uniform(0, radius)\n            \n            # Candidate x, y\n            cx = dist * math.cos(angle_rad)\n            cy = dist * math.sin(angle_rad)\n            cdeg = random.uniform(0, 360)\n            \n            cpoly = get_tree_polygon(cx, cy, cdeg)\n            \n            # Check collision\n            collision = False\n            # Checking collision with all previous is slow O(N^2), but N<=200 is small enough\n            for p in placed_polys:\n                if cpoly.intersects(p):\n                    collision = True\n                    break\n            \n            if not collision:\n                # Calculate new hypothetical bounding box\n                cbounds = cpoly.bounds\n                new_min_x = min(curr_min_x, cbounds[0])\n                new_max_x = max(curr_max_x, cbounds[2])\n                new_min_y = min(curr_min_y, cbounds[1])\n                new_max_y = max(curr_max_y, cbounds[3])\n                \n                # Metric: Minimize the side length of the bounding square\n                side = max(new_max_x - new_min_x, new_max_y - new_min_y)\n                \n                if side < best_metric:\n                    best_metric = side\n                    best_move = {\n                        'x': cx, 'y': cy, 'deg': cdeg,\n                        'poly': cpoly,\n                        'bounds': (new_min_x, new_max_x, new_min_y, new_max_y)\n                    }\n        \n        # If we found a valid move, place it. \n        # If not (rare with this simple logic), place far away (fallback)\n        if best_move:\n            placed_trees.append({'x': best_move['x'], 'y': best_move['y'], 'deg': best_move['deg']})\n            placed_polys.append(best_move['poly'])\n            curr_min_x, curr_max_x, curr_min_y, curr_max_y = best_move['bounds']\n        else:\n            # Fallback: Place far out to avoid crash (should refine in real submissions)\n            fallback_x = curr_max_x + 1.0\n            fallback_tree = {'x': fallback_x, 'y': 0, 'deg': 0}\n            placed_trees.append(fallback_tree)\n            placed_polys.append(get_tree_polygon(fallback_x, 0, 0))\n            # Update bounds roughly\n            curr_max_x = max(curr_max_x, fallback_x + 0.35)\n\n    return placed_trees\n\n# -----------------------------------------------------------------------------\n# 4. GENERATE SUBMISSION\n# -----------------------------------------------------------------------------\nprint(\"Generating submission for 1 to 200 trees...\")\n\nsubmission_rows = []\n\n# Iterate through all problem sizes\n# NOTE: Reduce trials or range for faster execution during testing\nfor n in tqdm(range(1, 201)):\n    # Solve\n    solution = solve_for_n(n, trials=100) # Increase trials for better score\n    \n    # Format for CSV\n    for i, tree in enumerate(solution):\n        row_id = f\"{n:03d}_{i}\"\n        # Requirement: string format with 's' prefix\n        # Coordinates constrained to [-100, 100] (Our heuristic keeps them near 0)\n        row = {\n            'id': row_id,\n            'x': f\"s{tree['x']:.10f}\",\n            'y': f\"s{tree['y']:.10f}\",\n            'deg': f\"s{tree['deg']:.10f}\"\n        }\n        submission_rows.append(row)\n\n# Create DataFrame\ndf_submission = pd.DataFrame(submission_rows)\n\n# Save to CSV\ndf_submission.to_csv('submission.csv', index=False)\n\nprint(\"Submission file 'submission.csv' created successfully.\")\nprint(df_submission.head())\n\n# Visualize one of the larger solutions\nprint(\"\\nVisualizing N=20 solution:\")\nsample_20 = [\n    {'x': float(r['x'][1:]), 'y': float(r['y'][1:]), 'deg': float(r['deg'][1:])} \n    for r in submission_rows if r['id'].startswith('020_')\n]\nplot_packing(sample_20, \"Packing N=20\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-18T16:10:23.147544Z","iopub.execute_input":"2025-11-18T16:10:23.147896Z","iopub.status.idle":"2025-11-18T16:22:23.400807Z","shell.execute_reply.started":"2025-11-18T16:10:23.147870Z","shell.execute_reply":"2025-11-18T16:22:23.399648Z"}},"outputs":[{"name":"stdout","text":"Visualizing single tree shape...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x800 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Generating submission for 1 to 200 trees