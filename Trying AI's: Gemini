    "def generate_lattice_layout(n):\n",
    "    \"\"\"\n",
    "    Generates a dense grid of n trees.\n",
    "    We try different aspect ratios (rows vs cols) to find the most 'square' result.\n",
    "    \"\"\"\n",
    "    \n",
    "    best_layout = []\n",
    "    best_side = float('inf')\n",
    "    \n",
    "    # The dimensions of our \"Unit Cell\" (one up, one down)\n",
    "    # Based on our pair optimization, we know the shift vector.\n",
    "    \n",
    "    # We treat the trees as having effective width/height roughly 0.7 and 1.0\n",
    "    # But packed tighter.\n",
    "    eff_w = 0.7 # Approximation, will be compacted later\n",
    "    eff_h = 1.0\n",
    "    \n",
    "    # Try different grid shapes (rows x cols) that fit roughly N trees\n",
    "    # We want a square-ish final bounding box.\n",
    "    \n",
    "    root_n = int(math.sqrt(n))\n",
    "    # We search aspect ratios around the square root\n",
    "    min_rows = max(1, root_n - 5)\n",
    "    max_rows = root_n + 5\n",
    "    \n",
    "    for rows in range(min_rows, max_rows + 1):\n",
    "        cols = math.ceil(n / rows)\n",
    "        \n",
    "        current_trees = []\n",
    "        \n",
    "        for r in range(rows):\n",
    "            for c in range(cols):\n",
    "                if len(current_trees) >= n:\n",
    "                    break\n",
    "                    \n",
    "                # Base Position in Grid\n",
    "                # We stagger rows slightly to fit the triangular tips?\n",
    "                # For now, simple grid of pairs.\n",
    "                \n",
    "                x_base = c * 0.7 # Spacing width\n",
    "                y_base = r * 1.0 # Spacing height\n",
    "                \n",
    "                # We alternate Up/Down in a checkerboard or linear pattern\n",
    "                # Pattern: UP, DOWN, UP, DOWN...\n",
    "                \n",
    "                is_even = (len(current_trees) % 2 == 0)\n",
    "                \n",
    "                if is_even:\n",
    "                    # Place Upright\n",
    "                    # We might need to adjust spacing based on row/col\n",
    "                    t = ChristmasTree(x_base, y_base, 0)\n",
    "                else:\n",
    "                    # Place Inverted (using the optimal offset relative to the previous even tree)\n",
    "                    # This effectively pairs them up\n",
    "                    t = ChristmasTree(x_base + PAIR_DX, y_base + PAIR_DY, 180)\n",
    "                \n",
    "                current_trees.append(t)\n",
    "        \n",
    "        # Center the cluster\n",
    "        polys = [t.poly for t in current_trees]\n",
    "        minx, miny, maxx, maxy = unary_union(polys).bounds\n",
    "        w, h = maxx-minx, maxy-miny\n",
    "        side = max(w, h)\n",
    "        \n",
    "        if side < best_side:\n",
    "            best_side = side\n",
    "            best_layout = current_trees\n",
    "            \n",
    "    return best_layout, best_side\n",
    "\n",
    "\n",
    "\n",
    "def squeeze_layout(trees, iterations=100):\n",
    "    \"\"\"\n",
    "    Takes a layout and greedily pushes trees towards the center.\n",
    "    Much faster than full Simulated Annealing for large N.\n",
    "    \"\"\"\n",
    "    # 1. Calculate Bounds Center\n",
    "    polys = [t.poly for t in trees]\n",
    "    minx, miny, maxx, maxy = unary_union(polys).bounds\n",
    "    cx, cy = (minx+maxx)/2, (miny+maxy)/2\n",
    "    \n",
    "    # 2. Iterative Squeeze\n",
    "    step_size = 0.1\n",
    "    \n",
    "    for _ in range(iterations):\n",
    "        moved_any = False\n",
    "        \n",
    "        # Randomize order to prevent bias\n",
    "        indices = list(range(len(trees)))\n",
    "        random.shuffle(indices)\n",
    "        \n",
    "        for i in indices:\n",
    "            t = trees[i]\n",
    "            \n",
    "            # Vector to center\n",
    "            dx = cx - t.x\n",
    "            dy = cy - t.y\n",
    "            dist = math.hypot(dx, dy)\n",
    "            if dist < 1e-6: continue\n",
    "            \n",
    "            # Normalize and scale\n",
    "            move_x = (dx / dist) * step_size\n",
    "            move_y = (dy / dist) * step_size\n",
    "            \n",
    "            # Try moving\n",
    "            orig_x, orig_y = t.x, t.y\n",
    "            t.set_pos(orig_x + move_x, orig_y + move_y, t.deg)\n",
    "            \n",
    "            # Check Collision\n",
    "            # We construct a list of OTHERS\n",
    "            # Note: For N=200 this is slow O(N^2). \n",
    "            # In a real contest, use STRtree. Here we rely on the lattice being mostly good.\n",
    "            collision = False\n",
    "            for j, other in enumerate(trees):\n",
    "                if i == j: continue\n",
    "                if t.poly.intersects(other.poly) and not t.poly.touches(other.poly):\n",
    "                    collision = True\n",
    "                    break\n",
    "            \n",
    "            if collision:\n",
    "                # Revert\n",
    "                t.set_pos(orig_x, orig_y, t.deg)\n",
    "            else:\n",
    "                moved_any = True\n",
    "        \n",
    "        if not moved_any:\n",
    "            step_size *= 0.5 # Refine precision\n",
    "            if step_size < 0.001: break\n",
    "            \n",
    "    # Final cleanup: Recenter\n",
    "    polys = [t.poly for t in trees]\n",
    "    minx, miny, maxx, maxy = unary_union(polys).bounds\n",
    "    width, height = maxx-minx, maxy-miny\n",
    "    \n",
    "    return trees, max(width, height)\n",
    "\n",
    "\n",
    "\n",
    "all_solutions = []\n",
    "total_score = 0\n",
    "\n",
    "print(\"Starting solution generation for N=1 to 200...\")\n",
    "\n",
    "for n in tqdm(range(1, 201)):\n",
    "    \n",
    "    # Strategy 1: Lattice Generation (Best for N > 5)\n",
    "    trees, side = generate_lattice_layout(n)\n",
    "    \n",
    "    # Strategy 2: Simple refinement (Squeeze gaps)\n",
    "    # We only run this for smaller N to save time, or run with few iterations\n",
    "    if n < 50:\n",
    "        trees, side = squeeze_layout(trees, iterations=50)\n",
    "    else:\n",
    "        # For large N, the lattice is usually already very good.\n",
    "        # Just simple centering.\n",
    "        trees, side = squeeze_layout(trees, iterations=10)\n",
    "\n",
    "    # Calculate Score Component for this N\n",
    "    score_component = (side**2) / n\n",
    "    total_score += score_component\n",
    "    \n",
    "    # Store Data\n",
    "    for i, t in enumerate(trees):\n",
    "        all_solutions.append({\n",
    "            'id': f\"{n:03d}_{i}\",\n",
    "            'x': t.x,\n",
    "            'y': t.y,\n",
    "            'deg': t.deg\n",
    "        })\n",
    "\n",
    "print(f\"Finished! Final Approximation Score: {total_score:.4f}\")\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "# Create DataFrame\n",
    "df = pd.DataFrame(all_solutions)\n",
    "\n",
    "# High Precision Formatter (Adding 's' and ensuring decimals)\n",
    "def format_submission(val):\n",
    "    return f\"s{val:.10f}\"\n",
    "\n",
    "submission = pd.DataFrame()\n",
    "submission['id'] = df['id']\n",
    "submission['x'] = df['x'].apply(format_submission)\n",
    "submission['y'] = df['y'].apply(format_submission)\n",
    "submission['deg'] = df['deg'].apply(format_submission)\n",
    "\n",
    "submission.to_csv('submission.csv', index=False)\n",
    "print(\"Saved 'submission.csv'. Ready to submit.\")\n",
    "print(submission.head())\n",
