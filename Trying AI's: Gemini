    "import math\n",
    "import random\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from shapely import affinity\n",
    "from shapely.geometry import Polygon\n",
    "from shapely.ops import unary_union\n",
    "from shapely.strtree import STRtree\n",
    "from tqdm.notebook import tqdm\n",
    "\n",
    "# We use standard floats for the physics engine to be fast.\n",
    "# We will convert to the required high-precision format only at the very end.\n",
    "SCALE = 1e15 \n",
    "print(\"Libraries loaded. Ready for Crystal Packing.\")\n",
    "\n",
    "\n",
    "\n",
    "class ChristmasTree:\n",
    "    # --- Definition of the Polygon (Same as Getting Started) ---\n",
    "    trunk_w = 0.15; trunk_h = 0.2; base_w = 0.7; mid_w = 0.4; top_w = 0.25\n",
    "    tip_y = 0.8; tier_1_y = 0.5; tier_2_y = 0.25; base_y = 0.0; trunk_bottom_y = -trunk_h\n",
    "    \n",
    "    BASE_VERTICES = [\n",
    "        (0.0, tip_y),\n",
    "        (top_w/2, tier_1_y), (top_w/4, tier_1_y),\n",
    "        (mid_w/2, tier_2_y), (mid_w/4, tier_2_y),\n",
    "        (base_w/2, base_y),\n",
    "        (trunk_w/2, base_y), (trunk_w/2, trunk_bottom_y),\n",
    "        (-trunk_w/2, trunk_bottom_y), (-trunk_w/2, base_y),\n",
    "        (-base_w/2, base_y),\n",
    "        (-mid_w/4, tier_2_y), (-mid_w/2, tier_2_y),\n",
    "        (-top_w/4, tier_1_y), (-top_w/2, tier_1_y)\n",
    "    ]\n",
    "    BASE_POLY = Polygon(BASE_VERTICES)\n",
    "\n",
    "    def __init__(self, x=0, y=0, deg=0):\n",
    "        self.x = x\n",
    "        self.y = y\n",
    "        self.deg = deg\n",
    "        self.poly = None\n",
    "        self.update_polygon()\n",
    "\n",
    "    def update_polygon(self):\n",
    "        # Rotating at the origin then translating is faster/cleaner\n",
    "        if self.deg == 0:\n",
    "            rotated = self.BASE_POLY\n",
    "        else:\n",
    "            rotated = affinity.rotate(self.BASE_POLY, self.deg, origin=(0, 0))\n",
    "        self.poly = affinity.translate(rotated, self.x, self.y)\n",
    "    \n",
    "    def set_pos(self, x, y, deg):\n",
    "        self.x = x\n",
    "        self.y = y\n",
    "        self.deg = deg\n",
    "        self.update_polygon()\n",
    "        \n",
    "    def copy(self):\n",
    "        return ChristmasTree(self.x, self.y, self.deg)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "def find_optimal_pair():\n",
    "    \"\"\"\n",
    "    Finds the tightest interlocking position for two trees.\n",
    "    We assume one is upright (0 deg) and one is inverted (180 deg) \n",
    "    because the shape is roughly triangular.\n",
    "    \"\"\"\n",
    "    t1 = ChristmasTree(0, 0, 0)\n",
    "    \n",
    "    best_pair = None\n",
    "    min_area = float('inf')\n",
    "    \n",
    "    # We scan a grid of positions for the second tree (inverted)\n",
    "    # The tree is approx 0.7 wide and 1.0 high. \n",
    "    # We search relative to t1.\n",
    "    \n",
    "    search_resolution = 0.05 # Coarse search\n",
    "    best_dx, best_dy = 0, 0\n",
    "    \n",
    "    # Grid search for rough locking\n",
    "    for dx in np.arange(-0.8, 0.8, search_resolution):\n",
    "        for dy in np.arange(-1.0, 1.0, search_resolution):\n",
    "            t2 = ChristmasTree(dx, dy, 180)\n",
    "            \n",
    "            # Fast overlap check\n",
    "            if t1.poly.intersects(t2.poly) and not t1.poly.touches(t2.poly):\n",
    "                continue\n",
    "                \n",
    "            # Valid pair? Measure box area\n",
    "            minx, miny, maxx, maxy = unary_union([t1.poly, t2.poly]).bounds\n",
    "            side = max(maxx-minx, maxy-miny)\n",
    "            area = side**2\n",
    "            \n",
    "            if area < min_area:\n",
    "                min_area = area\n",
    "                best_dx, best_dy = dx, dy\n",
    "    \n",
    "    # Fine tune optimization (Hill Climbing) around the best spot\n",
    "    current_dx, current_dy = best_dx, best_dy\n",
    "    step = 0.01\n",
    "    for _ in range(50):\n",
    "        found_better = False\n",
    "        for mx in [-step, 0, step]:\n",
    "            for my in [-step, 0, step]:\n",
    "                if mx == 0 and my == 0: continue\n",
    "                \n",
    "                nx, ny = current_dx + mx, current_dy + my\n",
    "                t2 = ChristmasTree(nx, ny, 180)\n",
    "                if t1.poly.intersects(t2.poly) and not t1.poly.touches(t2.poly):\n",
    "                    continue\n",
    "                    \n",
    "                minx, miny, maxx, maxy = unary_union([t1.poly, t2.poly]).bounds\n",
    "                side = max(maxx-minx, maxy-miny)\n",
    "                area = side**2\n",
    "                \n",
    "                if area < min_area:\n",
    "                    min_area = area\n",
    "                    current_dx, current_dy = nx, ny\n",
    "                    found_better = True\n",
    "        if not found_better:\n",
    "            step /= 2 # Increase precision\n",
    "            \n",
    "    print(f\"Optimal Interlock Found: dx={current_dx:.4f}, dy={current_dy:.4f}\")\n",
    "    return current_dx, current_dy\n",
    "\n",
    "# Calculate the offsets once\n",
    "# Usually a tree upside down fits into the \"shoulder\" of the upright one\n",
    "PAIR_DX, PAIR_DY = find_optimal_pair()"
   ]
