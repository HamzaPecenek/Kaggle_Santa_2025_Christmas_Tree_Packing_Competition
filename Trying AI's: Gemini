{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# =========================================================================================\n# Santa 2025 - Christmas Tree Packing Challenge\n# Complete Solution Notebook\n# =========================================================================================\n\n# -----------------------------------------------------------------------------------------\n# 1. IMPORTS & SETUP\n# -----------------------------------------------------------------------------------------\nimport math\nimport random\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom matplotlib.patches import Rectangle\nfrom shapely import affinity\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\nfrom shapely.strtree import STRtree\nfrom decimal import Decimal, getcontext\nfrom tqdm.notebook import tqdm  # Progress bar\n\n# Set high precision for the problem requirements\ngetcontext().prec = 50 \n# Scale factor to handle float precision issues in Shapely by working in \"integers\" effectively\nscale_factor = Decimal('1e15')\n\nprint(\"Setup Complete. Libraries Loaded.\")\n\n# -----------------------------------------------------------------------------------------\n# 2. FEATURE ENGINEERING: GEOMETRY DEFINITION\n# -----------------------------------------------------------------------------------------\n# The \"Features\" in this problem are the geometric shapes of the trees.\n# We define the ChristmasTree class to encapsulate the polygon logic.\n\nclass ChristmasTree:\n    \"\"\"Represents a single, rotatable Christmas tree of a fixed size.\"\"\"\n\n    def __init__(self, center_x='0', center_y='0', angle='0'):\n        self.center_x = Decimal(center_x)\n        self.center_y = Decimal(center_y)\n        self.angle = Decimal(angle)\n\n        # Dimensions defined in the problem description\n        trunk_w = Decimal('0.15')\n        trunk_h = Decimal('0.2')\n        base_w = Decimal('0.7')\n        mid_w = Decimal('0.4')\n        top_w = Decimal('0.25')\n        tip_y = Decimal('0.8')\n        tier_1_y = Decimal('0.5')\n        tier_2_y = Decimal('0.25')\n        base_y = Decimal('0.0')\n        trunk_bottom_y = -trunk_h\n\n        # Define the base polygon shape (centered roughly at origin relative to logic)\n        self.initial_polygon = Polygon(\n            [\n                (Decimal('0.0') * scale_factor, tip_y * scale_factor),\n                (top_w / Decimal('2') * scale_factor, tier_1_y * scale_factor),\n                (top_w / Decimal('4') * scale_factor, tier_1_y * scale_factor),\n                (mid_w / Decimal('2') * scale_factor, tier_2_y * scale_factor),\n                (mid_w / Decimal('4') * scale_factor, tier_2_y * scale_factor),\n                (base_w / Decimal('2') * scale_factor, base_y * scale_factor),\n                (trunk_w / Decimal('2') * scale_factor, base_y * scale_factor),\n                (trunk_w / Decimal('2') * scale_factor, trunk_bottom_y * scale_factor),\n                (-(trunk_w / Decimal('2')) * scale_factor, trunk_bottom_y * scale_factor),\n                (-(trunk_w / Decimal('2')) * scale_factor, base_y * scale_factor),\n                (-(base_w / Decimal('2')) * scale_factor, base_y * scale_factor),\n                (-(mid_w / Decimal('4')) * scale_factor, tier_2_y * scale_factor),\n                (-(mid_w / Decimal('2')) * scale_factor, tier_2_y * scale_factor),\n                (-(top_w / Decimal('4')) * scale_factor, tier_1_y * scale_factor),\n                (-(top_w / Decimal('2')) * scale_factor, tier_1_y * scale_factor),\n            ]\n        )\n        self.update_polygon()\n\n    def update_polygon(self):\n        \"\"\"Updates the shapely polygon based on current center_x, center_y, and angle.\"\"\"\n        # Rotate first (around origin 0,0 of the shape)\n        rotated = affinity.rotate(self.initial_polygon, float(self.angle), origin=(0, 0))\n        # Then translate to global position\n        self.polygon = affinity.translate(rotated,\n                                          xoff=float(self.center_x * scale_factor),\n                                          yoff=float(self.center_y * scale_factor))\n\n# -----------------------------------------------------------------------------------------\n# 3. EDA: VISUALIZATION\n# -----------------------------------------------------------------------------------------\n# Let's visualize a single tree to understand what we are packing.\n\ndef plot_single_tree():\n    tree = ChristmasTree(angle='15') # Slight rotation\n    fig, ax = plt.subplots(figsize=(4, 4))\n    \n    x_scaled, y_scaled = tree.polygon.exterior.xy\n    x = [val / float(scale_factor) for val in x_scaled]\n    y = [val / float(scale_factor) for val in y_scaled]\n    \n    ax.plot(x, y, color='green')\n    ax.fill(x, y, alpha=0.5, color='green')\n    ax.set_aspect('equal')\n    ax.set_title(\"EDA: Single Tree Shape\")\n    plt.grid(True, alpha=0.3)\n    plt.show()\n\nplot_single_tree()\n\n# -----------------------------------------------------------------------------------------\n# 4. OPTIMIZATION / \"TRAINING\" LOOP\n# -----------------------------------------------------------------------------------------\n# We implement a Greedy Strategy:\n# 1. Keep the configuration of N-1 trees.\n# 2. To add the Nth tree, try K random angles.\n# 3. For each angle, start far away and move towards the center until collision.\n# 4. Pick the position that minimizes the distance from center (or side length).\n\ndef generate_weighted_angle():\n    \"\"\"Generates a random angle, favoring corners (where sin(2*angle) is high).\"\"\"\n    while True:\n        angle = random.uniform(0, 360)\n        rad = math.radians(angle)\n        # Weight probability by sin(2*a) to prefer diagonal placements\n        if random.uniform(0, 1) < abs(math.sin(2 * rad)):\n            return angle\n\ndef solve_for_n(n, existing_trees):\n    \"\"\"\n    Adds the nth tree to the list of existing_trees using a greedy search.\n    Returns the updated list of trees and the resulting side length.\n    \"\"\"\n    # If it's the very first tree, place it at 0,0\n    if n == 1:\n        first_tree = ChristmasTree(center_x='0', center_y='0', angle='0')\n        return [first_tree], Decimal('0')\n\n    # We will try multiple attempts to place the Nth tree and pick the best one\n    best_tree = None\n    min_added_radius = Decimal('Infinity')\n    \n    # Helper for collision detection\n    placed_polygons = [t.polygon for t in existing_trees]\n    tree_index = STRtree(placed_polygons)\n    \n    # Try 25 different random angles/approaches (Higher = slower but better results)\n    ATTEMPTS = 25 \n    \n    for _ in range(ATTEMPTS):\n        angle = generate_weighted_angle()\n        rad = math.radians(angle)\n        vx = Decimal(str(math.cos(rad)))\n        vy = Decimal(str(math.sin(rad)))\n        \n        # Create a temporary tree object\n        temp_tree = ChristmasTree(angle=str(angle))\n        \n        # Ray Casting: Start far (radius 25) and march in\n        radius = Decimal('25.0')\n        step_in = Decimal('0.5')\n        \n        collision = False\n        \n        # Coarse search inwards\n        while radius >= 0:\n            px = radius * vx\n            py = radius * vy\n            \n            # Check collision at (px, py)\n            # We manually translate the polygon for check without updating the object yet\n            cand_poly = affinity.translate(\n                temp_tree.initial_polygon, # Rotate was done in init, this is just translate\n                xoff=float(px * scale_factor), \n                yoff=float(py * scale_factor)\n            )\n            # Rotate needs to be applied to initial if not done, but our class handles it.\n            # Wait, our class applies rotate then translate in update_polygon. \n            # Let's manually do it to be fast:\n            cand_poly = affinity.translate(\n                affinity.rotate(temp_tree.initial_polygon, float(temp_tree.angle), origin=(0,0)),\n                xoff=float(px * scale_factor),\n                yoff=float(py * scale_factor)\n            )\n            \n            query_res = tree_index.query(cand_poly)\n            \n            # Check intersection\n            is_hit = False\n            for i in query_res:\n                if cand_poly.intersects(placed_polygons[i]) and not cand_poly.touches(placed_polygons[i]):\n                    is_hit = True\n                    break\n            \n            if is_hit:\n                collision = True\n                break\n            \n            radius -= step_in\n        \n        # If we hit something, back up slowly to find the \"touching\" point\n        if collision:\n            step_out = Decimal('0.05')\n            while True:\n                radius += step_out\n                px = radius * vx\n                py = radius * vy\n                \n                cand_poly = affinity.translate(\n                    affinity.rotate(temp_tree.initial_polygon, float(temp_tree.angle), origin=(0,0)),\n                    xoff=float(px * scale_factor),\n                    yoff=float(py * scale_factor)\n                )\n                \n                query_res = tree_index.query(cand_poly)\n                is_hit = False\n                for i in query_res:\n                    if cand_poly.intersects(placed_polygons[i]) and not cand_poly.touches(placed_polygons[i]):\n                        is_hit = True\n                        break\n                \n                if not is_hit:\n                    break # We are now just outside\n        else:\n            # No collision all the way to center\n            radius = Decimal('0')\n            px, py = Decimal('0'), Decimal('0')\n\n        # Check if this attempt is better (smaller radius)\n        if radius < min_added_radius:\n            min_added_radius = radius\n            best_tree = ChristmasTree(center_x=str(px), center_y=str(py), angle=str(angle))\n\n    # Add the best candidate to our list\n    new_trees = existing_trees + [best_tree]\n    \n    # Calculate side length\n    all_polys = [t.polygon for t in new_trees]\n    minx, miny, maxx, maxy = unary_union(all_polys).bounds\n    width = (Decimal(maxx) - Decimal(minx)) / scale_factor\n    height = (Decimal(maxy) - Decimal(miny)) / scale_factor\n    side_length = max(width, height)\n    \n    return new_trees, side_length\n\n# -----------------------------------------------------------------------------------------\n# 5. MAIN EXECUTION LOOP\n# -----------------------------------------------------------------------------------------\n# We iterate from N=1 to 200. \n# We persist the solution from N-1 to start N.\n\nsubmission_data = []\ncurrent_trees = []\nmetrics = []\n\nprint(\"Starting Optimization Loop...\")\n\nfor n in tqdm(range(1, 201), desc=\"Packing Trees\"):\n    current_trees, side = solve_for_n(n, current_trees)\n    \n    # Calculate metric contribution: s^2 / n\n    score_contribution = (side ** 2) / Decimal(n)\n    metrics.append(score_contribution)\n    \n    # Save data for submission\n    for i, tree in enumerate(current_trees):\n        # ID format: 001_0, 002_0, etc.\n        row_id = f\"{n:03d}_{i}\"\n        submission_data.append({\n            \"id\": row_id,\n            \"x\": tree.center_x,\n            \"y\": tree.center_y,\n            \"deg\": tree.angle\n        })\n\ntotal_score = sum(metrics)\nprint(f\"\\nOptimization Complete.\")\nprint(f\"Estimated Total Score: {total_score:.6f}\")\n\n# -----------------------------------------------------------------------------------------\n# 6. EVALUATION: PLOT METRICS\n# -----------------------------------------------------------------------------------------\n# Plot the side length growth\nsides = [math.sqrt(float(m * (i+1))) for i, m in enumerate(metrics)]\nplt.figure(figsize=(10, 5))\nplt.plot(range(1, 201), sides)\nplt.title(\"Growth of Bounding Box Side Length\")\nplt.xlabel(\"Number of Trees (N)\")\nplt.ylabel(\"Side Length\")\nplt.grid(True)\nplt.show()\n\n# -----------------------------------------------------------------------------------------\n# 7. SUBMISSION FILE GENERATION\n# -----------------------------------------------------------------------------------------\n# Convert to DataFrame\ndf_sub = pd.DataFrame(submission_data)\n\n# Format columns as required:\n# 1. Round to 6 decimals (optional but good for cleaner files)\n# 2. Prepend 's' to string representation to avoid float precision loss during CSV read/write\n\ncols = ['x', 'y', 'deg']\nfor col in cols:\n    # Rounding logic\n    df_sub[col] = df_sub[col].apply(lambda x: f\"{float(x):.6f}\")\n    # Prepend 's'\n    df_sub[col] = \"s\" + df_sub[col]\n\n# Save\ndf_sub.to_csv(\"submission.csv\", index=False)\nprint(\"submission.csv saved successfully!\")\n\n# Display first few rows\nprint(df_sub.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-18T06:34:33.650182Z","iopub.execute_input":"2025-11-18T06:34:33.650579Z","iopub.status.idle":"2025-11-18T06:35:24.977939Z","shell.execute_reply.started":"2025-11-18T06:34:33.650547Z","shell.execute_reply":"2025-11-18T06:35:24.976914Z"}},"outputs":[{"name":"stdout","text":"Setup Complete. Libraries Loaded.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 400x400 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Starting Optimization Loop...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Packing Trees:   0%|          | 0/200 [00:00<?, ?it/s