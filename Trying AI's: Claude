{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":119106,"databundleVersionId":14485445,"sourceType":"competition"}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# Cell 1: Import Libraries\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom matplotlib.patches import Polygon as MplPolygon\nfrom matplotlib.patches import Circle\nfrom shapely.geometry import Polygon, Point, LineString\nfrom shapely.affinity import rotate, translate\nfrom shapely.ops import unary_union\nfrom shapely.errors import GEOSException  # <-- important for robust error handling\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"Libraries imported successfully!\")\n\n# ============================================================\n# Cell 2: Load and Explore Data\n# ============================================================\n# Load sample submission\nsample_sub = pd.read_csv('/kaggle/input/santa-2025/sample_submission.csv')\n\n# Parse the data - remove 's' prefix and convert to float\nsample_sub['x'] = sample_sub['x'].str.replace('s', '').astype(float)\nsample_sub['y'] = sample_sub['y'].str.replace('s', '').astype(float)\nsample_sub['deg'] = sample_sub['deg'].str.replace('s', '').astype(float)\n\n# Extract tree count from id (e.g., '001_0' -> n=1, '002_0' -> n=2)\nsample_sub['n_trees'] = sample_sub['id'].str.split('_').str[0].astype(int)\nsample_sub['tree_idx'] = sample_sub['id'].str.split('_').str[1].astype(int)\n\nprint(f\"Total rows: {len(sample_sub)}\")\nprint(f\"\\nFirst few rows:\")\nprint(sample_sub.head(10))\nprint(f\"\\nData types:\")\nprint(sample_sub.dtypes)\nprint(f\"\\nBasic statistics:\")\nprint(sample_sub[['x', 'y', 'deg']].describe())\n\n# ============================================================\n# Cell 3: EDA - Distribution Analysis\n# ============================================================\nfig, axes = plt.subplots(2, 2, figsize=(15, 12))\n\n# Distribution of x coordinates\naxes[0, 0].hist(sample_sub['x'], bins=50, edgecolor='black', alpha=0.7, color='green')\naxes[0, 0].set_title('Distribution of X Coordinates', fontsize=14, fontweight='bold')\naxes[0, 0].set_xlabel('X')\naxes[0, 0].set_ylabel('Frequency')\naxes[0, 0].grid(alpha=0.3)\n\n# Distribution of y coordinates\naxes[0, 1].hist(sample_sub['y'], bins=50, edgecolor='black', alpha=0.7, color='red')\naxes[0, 1].set_title('Distribution of Y Coordinates', fontsize=14, fontweight='bold')\naxes[0, 1].set_xlabel('Y')\naxes[0, 1].set_ylabel('Frequency')\naxes[0, 1].grid(alpha=0.3)\n\n# Distribution of rotation angles\naxes[1, 0].hist(sample_sub['deg'], bins=50, edgecolor='black', alpha=0.7, color='blue')\naxes[1, 0].set_title('Distribution of Rotation Angles', fontsize=14, fontweight='bold')\naxes[1, 0].set_xlabel('Degrees')\naxes[1, 0].set_ylabel('Frequency')\naxes[1, 0].grid(alpha=0.3)\n\n# Number of trees per configuration\ntree_counts = sample_sub['n_trees'].value_counts().sort_index()\naxes[1, 1].bar(tree_counts.index, tree_counts.values, edgecolor='black', alpha=0.7, color='purple')\naxes[1, 1].set_title('Trees per Configuration', fontsize=14, fontweight='bold')\naxes[1, 1].set_xlabel('Number of Trees (n)')\naxes[1, 1].set_ylabel('Count of Trees in Sample')\naxes[1, 1].grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# ============================================================\n# Cell 4: Define Christmas Tree Geometry\n# ============================================================\ndef create_tree_polygon(rotation_deg=0):\n    \"\"\"\n    Creates a Christmas tree polygon shape.\n    Tree is centered at origin with trunk center at (0, 0).\n    \n    Standard tree dimensions (approximate):\n    - Width at base: 1.0 unit\n    - Height of foliage: 1.2 units  \n    - Trunk width: 0.2 units\n    - Trunk height: 0.3 units\n    \"\"\"\n    # Tree foliage (triangle)\n    foliage_points = [\n        (-0.5, 0.3),   # Left base of foliage\n        (0.5, 0.3),    # Right base of foliage\n        (0.0, 1.5)     # Top of tree\n    ]\n    \n    # Trunk (rectangle)\n    trunk_points = [\n        (-0.1, 0.0),   # Bottom left of trunk\n        (0.1, 0.0),    # Bottom right of trunk\n        (0.1, 0.3),    # Top right of trunk\n        (-0.1, 0.3)    # Top left of trunk\n    ]\n    \n    # Combine foliage and trunk\n    all_points = trunk_points + foliage_points\n    \n    # Create polygon\n    tree = Polygon(all_points)\n    \n    # Rotate if needed\n    if rotation_deg != 0:\n        tree = rotate(tree, rotation_deg, origin=(0, 0))\n    \n    return tree\n\n# Test tree creation\ntest_tree = create_tree_polygon(0)\nprint(f\"Tree area: {test_tree.area:.4f}\")\nprint(f\"Tree bounds: {test_tree.bounds}\")\n\n# ============================================================\n# Cell 5: Visualization Function\n# ============================================================\ndef visualize_configuration(df, n_trees, figsize=(12, 12)):\n    \"\"\"\n    Visualize a specific n-tree configuration.\n    Works both when df has 'tree_idx' and when it doesn't.\n    \"\"\"\n    # Filter data for specific n\n    config_data = df[df['n_trees'] == n_trees].copy()\n    \n    if len(config_data) == 0:\n        print(f\"No data for n={n_trees}\")\n        return\n    \n    fig, ax = plt.subplots(figsize=figsize)\n    \n    # Calculate bounding box\n    all_x = []\n    all_y = []\n    \n    has_tree_idx = 'tree_idx' in config_data.columns\n    \n    # Plot each tree\n    for local_idx, (idx, row) in enumerate(config_data.iterrows()):\n        x, y, deg = row['x'], row['y'], row['deg']\n        \n        # Create tree polygon\n        tree = create_tree_polygon(deg)\n        tree = translate(tree, xoff=x, yoff=y)\n        \n        # Extract coordinates for plotting\n        coords = list(tree.exterior.coords)\n        xs, ys = zip(*coords)\n        all_x.extend(xs)\n        all_y.extend(ys)\n        \n        # Plot tree\n        polygon = MplPolygon(\n            coords,\n            facecolor='green',\n            edgecolor='darkgreen',\n            alpha=0.6,\n            linewidth=2\n        )\n        ax.add_patch(polygon)\n        \n        # Mark center point\n        ax.plot(x, y, 'ro', markersize=5)\n        \n        # Use tree_idx if present, otherwise fall back to local index\n        label_idx = row['tree_idx'] if has_tree_idx else local_idx\n        ax.text(\n            x, y - 0.1, f'{int(label_idx)}',\n            ha='center', va='top', fontsize=8, color='red'\n        )\n    \n    # Calculate and draw bounding box\n    min_x, max_x = min(all_x), max(all_x)\n    min_y, max_y = min(all_y), max(all_y)\n    \n    # Determine square box size (max of width and height)\n    width = max_x - min_x\n    height = max_y - min_y\n    box_size = max(width, height)\n    \n    # Center the square box\n    center_x = (min_x + max_x) / 2\n    center_y = (min_y + max_y) / 2\n    \n    box_min_x = center_x - box_size / 2\n    box_max_x = center_x + box_size / 2\n    box_min_y = center_y - box_size / 2\n    box_max_y = center_y + box_size / 2\n    \n    # Draw bounding box\n    ax.plot(\n        [box_min_x, box_max_x, box_max_x, box_min_x, box_min_x],\n        [box_min_y, box_min_y, box_max_y, box_max_y, box_min_y],\n        'r--',\n        linewidth=2,\n        label=f'Bounding Box (side={box_size:.3f})'\n    )\n    \n    # Calculate score\n    score = (box_size ** 2) / n_trees\n    \n    ax.set_xlim(box_min_x - 0.5, box_max_x + 0.5)\n    ax.set_ylim(box_min_y - 0.5, box_max_y + 0.5)\n    ax.set_aspect('equal')\n    ax.grid(True, alpha=0.3)\n    ax.set_title(\n        f'Configuration: {n_trees} Trees\\nBox Size: {box_size:.3f}, Score: {score:.4f}',\n        fontsize=14,\n        fontweight='bold'\n    )\n    ax.set_xlabel('X')\n    ax.set_ylabel('Y')\n    ax.legend()\n    \n    plt.tight_layout()\n    plt.show()\n    \n    return box_size, score\n\n# ============================================================\n# Cell 6: Robust Collision Detection\n# ============================================================\ndef polygons_collide(poly1, poly2, area_tol=1e-6):\n    \"\"\"\n    Robust collision test between two polygons.\n    Returns True if they overlap with area > area_tol.\n    Handles invalid geometries and GEOS numerical issues.\n    \"\"\"\n    try:\n        if not poly1.is_valid:\n            poly1 = poly1.buffer(0)\n        if not poly2.is_valid:\n            poly2 = poly2.buffer(0)\n\n        if poly1.is_empty or poly2.is_empty:\n            return False\n\n        if not poly1.intersects(poly2):\n            return False\n\n        inter = poly1.intersection(poly2)\n\n        if inter.is_empty:\n            return False\n\n        # Some intersection types might not have a meaningful area\n        area = getattr(inter, \"area\", None)\n        if area is None:\n            # Line/point intersection (no area) -> no collision for our purposes\n            return False\n\n        return area > area_tol\n\n    except GEOSException:\n        # If GEOS fails, treat as collision so the move is rejected\n        return True\n\ndef check_collisions(trees_data):\n    \"\"\"\n    Check if any trees overlap in a configuration.\n    Returns True if collision detected, False otherwise.\n    \"\"\"\n    polygons = []\n    \n    for idx, row in trees_data.iterrows():\n        tree = create_tree_polygon(row['deg'])\n        tree = translate(tree, xoff=row['x'], yoff=row['y'])\n        polygons.append(tree)\n    \n    # Check all pairs for intersection\n    for i in range(len(polygons)):\n        for j in range(i+1, len(polygons)):\n            if polygons_collide(polygons[i], polygons[j]):\n                return True, (i, j)\n    \n    return False, None\n\n# Test collision detection on sample\nprint(\"Checking for collisions in sample submission...\")\ncollision_found = False\nfor n in sample_sub['n_trees'].unique():\n    config_data = sample_sub[sample_sub['n_trees'] == n]\n    has_collision, pair = check_collisions(config_data)\n    if has_collision:\n        print(f\"⚠️  Collision found in n={n} configuration between trees {pair}\")\n        collision_found = True\n\nif not collision_found:\n    print(\"✅ No collisions detected in sample submission!\")\n\n# ============================================================\n# Cell 7: Score Calculation\n# ============================================================\ndef calculate_score(df):\n    \"\"\"\n    Calculate the competition score for a submission.\n    Score = sum of (s^2 / n) for each n-tree configuration.\n    \"\"\"\n    total_score = 0\n    scores_detail = []\n    \n    for n in sorted(df['n_trees'].unique()):\n        config_data = df[df['n_trees'] == n]\n        \n        # Get all tree polygons\n        all_x, all_y = [], []\n        for idx, row in config_data.iterrows():\n            tree = create_tree_polygon(row['deg'])\n            tree = translate(tree, xoff=row['x'], yoff=row['y'])\n            coords = list(tree.exterior.coords)\n            xs, ys = zip(*coords)\n            all_x.extend(xs)\n            all_y.extend(ys)\n        \n        # Calculate square bounding box size\n        min_x, max_x = min(all_x), max(all_x)\n        min_y, max_y = min(all_y), max(all_y)\n        width = max_x - min_x\n        height = max_y - min_y\n        s = max(width, height)  # Side of square box\n        \n        # Calculate score for this configuration\n        config_score = (s ** 2) / n\n        total_score += config_score\n        \n        scores_detail.append({\n            'n_trees': n,\n            'box_side': s,\n            'score': config_score\n        })\n    \n    return total_score, pd.DataFrame(scores_detail)\n\n# Calculate score for sample submission\ntotal_score, score_details = calculate_score(sample_sub)\n\nprint(f\"Sample Submission Total Score: {total_score:.6f}\")\nprint(f\"\\nScore breakdown by configuration:\")\nprint(score_details.head(20))\n\n# Visualize score distribution\nplt.figure(figsize=(14, 5))\n\nplt.subplot(1, 2, 1)\nplt.plot(score_details['n_trees'], score_details['score'], 'o-', linewidth=2, markersize=6)\nplt.xlabel('Number of Trees (n)', fontsize=12)\nplt.ylabel('Score (s²/n)', fontsize=12)\nplt.title('Score per Configuration', fontsize=14, fontweight='bold')\nplt.grid(alpha=0.3)\n\nplt.subplot(1, 2, 2)\nplt.plot(score_details['n_trees'], score_details['box_side'], 's-', \n         linewidth=2, markersize=6, color='green')\nplt.xlabel('Number of Trees (n)', fontsize=12)\nplt.ylabel('Bounding Box Side Length', fontsize=12)\nplt.title('Box Size Growth', fontsize=14, fontweight='bold')\nplt.grid(alpha=0.3)\n\nplt.tight_layout()\nplt.show()\n\n# ============================================================\n# Cell 8: Optimization Strategy - Circular Packing\n# ============================================================\ndef create_circular_packing(n_trees):\n    \"\"\"\n    Simple circular packing strategy.\n    Places trees in concentric circles.\n    \"\"\"\n    positions = []\n    \n    if n_trees == 1:\n        positions.append((0, 0, 0))\n    elif n_trees == 2:\n        positions.append((-0.6, 0, 0))\n        positions.append((0.6, 0, 0))\n    else:\n        # Place trees in circular pattern\n        radius = 0.8 * np.sqrt(n_trees)\n        angles = np.linspace(0, 2*np.pi, n_trees, endpoint=False)\n        \n        for i, angle in enumerate(angles):\n            x = radius * np.cos(angle)\n            y = radius * np.sin(angle)\n            # Point trees toward center\n            rotation = np.degrees(angle) + 90\n            positions.append((x, y, rotation))\n    \n    return positions\n\n# Test circular packing\nprint(\"Testing circular packing strategy...\")\ntest_n_values = [1, 3, 5, 7, 10, 15, 20]\n\nfor n in test_n_values:\n    positions = create_circular_packing(n)\n    print(f\"n={n}: Created {len(positions)} positions\")\n\n# ============================================================\n# Cell 9: Optimization Strategy - Hexagonal Grid Packing\n# ============================================================\ndef create_hexagonal_packing(n_trees):\n    \"\"\"\n    Hexagonal grid packing - efficient for circular objects.\n    \"\"\"\n    positions = []\n    \n    if n_trees == 1:\n        return [(0, 0, 0)]\n    \n    # Spacing between trees\n    spacing = 1.3  # Adjust based on tree size\n    \n    # Calculate how many rings we need\n    current_count = 0\n    ring = 0\n    \n    # Center tree\n    positions.append((0, 0, 0))\n    current_count += 1\n    \n    while current_count < n_trees:\n        ring += 1\n        # Number of positions in this ring\n        ring_positions = 6 * ring\n        \n        for i in range(min(ring_positions, n_trees - current_count)):\n            angle = (2 * np.pi * i) / ring_positions\n            radius = ring * spacing\n            x = radius * np.cos(angle)\n            y = radius * np.sin(angle)\n            rotation = np.random.uniform(0, 360)  # Random rotation\n            positions.append((x, y, rotation))\n            current_count += 1\n            \n            if current_count >= n_trees:\n                break\n    \n    return positions\n\n# Test hexagonal packing\nprint(\"Testing hexagonal packing strategy...\")\nfor n in [1, 7, 19, 37]:\n    positions = create_hexagonal_packing(n)\n    print(f\"n={n}: Created {len(positions)} positions\")\n\n# ============================================================\n# Cell 10: Optimization Strategy - Spiral Packing\n# ============================================================\ndef create_spiral_packing(n_trees):\n    \"\"\"\n    Spiral packing strategy - Archimedean spiral.\n    \"\"\"\n    positions = []\n    \n    if n_trees == 1:\n        return [(0, 0, 0)]\n    \n    # Spiral parameters\n    a = 0.3  # Spiral tightness\n    b = 0.5  # Spiral growth rate\n    \n    for i in range(n_trees):\n        theta = i * 0.8  # Angular step\n        r = a + b * theta\n        \n        x = r * np.cos(theta)\n        y = r * np.sin(theta)\n        rotation = np.degrees(theta)\n        \n        positions.append((x, y, rotation))\n    \n    return positions\n\n# Test spiral packing\nprint(\"Testing spiral packing strategy...\")\nfor n in [5, 10, 20, 50]:\n    positions = create_spiral_packing(n)\n    print(f\"n={n}: Created {len(positions)} positions\")\n\n# ============================================================\n# Cell 11: Advanced Optimization - Simulated Annealing\n# ============================================================\ndef simulated_annealing_packing(n_trees, iterations=1000, initial_temp=1.0):\n    \"\"\"\n    Use simulated annealing to find optimal tree positions.\n    \"\"\"\n    # Start with hexagonal packing\n    positions = create_hexagonal_packing(n_trees)\n    current_positions = np.array(positions)\n    \n    # Calculate initial score\n    def calculate_config_score(positions_array):\n        all_x, all_y = [], []\n        for x, y, deg in positions_array:\n            tree = create_tree_polygon(deg)\n            tree = translate(tree, xoff=x, yoff=y)\n            coords = list(tree.exterior.coords)\n            xs, ys = zip(*coords)\n            all_x.extend(xs)\n            all_y.extend(ys)\n        \n        width = max(all_x) - min(all_x)\n        height = max(all_y) - min(all_y)\n        s = max(width, height)\n        return (s ** 2) / n_trees\n    \n    current_score = calculate_config_score(current_positions)\n    best_positions = current_positions.copy()\n    best_score = current_score\n    \n    temperature = initial_temp\n    \n    for iteration in range(iterations):\n        # Create neighbor solution\n        new_positions = current_positions.copy()\n        \n        # Randomly perturb one tree (smaller step for stability)\n        tree_idx = np.random.randint(0, n_trees)\n        new_positions[tree_idx, 0] += np.random.normal(0, 0.1)  # x\n        new_positions[tree_idx, 1] += np.random.normal(0, 0.1)  # y\n        new_positions[tree_idx, 2] += np.random.normal(0, 10)   # rotation\n        \n        # Check for collisions (robust)\n        has_collision = False\n        for i in range(n_trees):\n            for j in range(i+1, n_trees):\n                # quick center-distance pre-check to skip obvious non-collisions\n                dx = new_positions[i, 0] - new_positions[j, 0]\n                dy = new_positions[i, 1] - new_positions[j, 1]\n                # if farther than 3 units, they cannot overlap with this tree size\n                if dx*dx + dy*dy > 9.0:\n                    continue\n\n                tree_i = create_tree_polygon(new_positions[i, 2])\n                tree_i = translate(tree_i, xoff=new_positions[i, 0], yoff=new_positions[i, 1])\n\n                tree_j = create_tree_polygon(new_positions[j, 2])\n                tree_j = translate(tree_j, xoff=new_positions[j, 0], yoff=new_positions[j, 1])\n\n                if polygons_collide(tree_i, tree_j):\n                    has_collision = True\n                    break\n            if has_collision:\n                break\n        \n        if has_collision:\n            # Reject this neighbor; try another\n            continue\n        \n        # Calculate new score\n        new_score = calculate_config_score(new_positions)\n        \n        # Accept or reject\n        delta = new_score - current_score\n        if delta < 0 or np.random.random() < np.exp(-delta / temperature):\n            current_positions = new_positions\n            current_score = new_score\n            \n            if current_score < best_score:\n                best_positions = current_positions.copy()\n                best_score = current_score\n        \n        # Cool down\n        temperature *= 0.995\n        \n        if iteration % 100 == 0:\n            print(f\"Iteration {iteration}: Best score = {best_score:.6f}, Temp = {temperature:.6f}\")\n    \n    return best_positions, best_score\n\n# Test on small configurations\nprint(\"Testing Simulated Annealing on small configurations...\")\nprint(\"This may take a few minutes...\")\n\ntest_results = {}\nfor n in [3, 5, 7]:\n    print(f\"\\n{'='*60}\")\n    print(f\"Optimizing n={n} configuration\")\n    print(f\"{'='*60}\")\n    best_pos, best_score = simulated_annealing_packing(n, iterations=500)\n    test_results[n] = (best_pos, best_score)\n    print(f\"Final best score for n={n}: {best_score:.6f}\")\n\n# ============================================================\n# Cell 12: Generate Improved Submission\n# ============================================================\ndef generate_submission(max_n=200, strategy='hexagonal'):\n    \"\"\"\n    Generate a complete submission file.\n    \"\"\"\n    submission_data = []\n    \n    for n in range(1, max_n + 1):\n        if strategy == 'hexagonal':\n            positions = create_hexagonal_packing(n)\n        elif strategy == 'circular':\n            positions = create_circular_packing(n)\n        elif strategy == 'spiral':\n            positions = create_spiral_packing(n)\n        else:\n            positions = create_hexagonal_packing(n)\n        \n        for tree_idx, (x, y, deg) in enumerate(positions):\n            # Constrain to required range\n            x = np.clip(x, -100, 100)\n            y = np.clip(y, -100, 100)\n            deg = deg % 360  # Keep rotation in [0, 360)\n            \n            tree_id = f\"{n:03d}_{tree_idx}\"\n            submission_data.append({\n                'id': tree_id,\n                'x': f\"s{x:.6f}\",\n                'y': f\"s{y:.6f}\",\n                'deg': f\"s{deg:.6f}\"\n            })\n    \n    return pd.DataFrame(submission_data)\n\n# Generate submission with hexagonal packing\nprint(\"Generating submission with hexagonal packing...\")\nsubmission = generate_submission(max_n=200, strategy='hexagonal')\n\nprint(f\"Generated {len(submission)} rows\")\nprint(f\"\\nFirst few rows:\")\nprint(submission.head(10))\nprint(f\"\\nLast few rows:\")\nprint(submission.tail(10))\n\n# ============================================================\n# Cell 13: Validate Submission\n# ============================================================\n\ndef validate_submission(df):\n    \"\"\"\n    Validate submission format and constraints.\n    \"\"\"\n    errors = []\n    warnings_list = []\n    \n    # Check required columns\n    required_cols = ['id', 'x', 'y', 'deg']\n    for col in required_cols:\n        if col not in df.columns:\n            errors.append(f\"Missing required column: {col}\")\n    \n    if errors:\n        return False, errors, warnings_list\n    \n    # Parse values\n    df_copy = df.copy()\n    try:\n        df_copy['x_val'] = df_copy['x'].str.replace('s', '').astype(float)\n        df_copy['y_val'] = df_copy['y'].str.replace('s', '').astype(float)\n        df_copy['deg_val'] = df_copy['deg'].str.replace('s', '').astype(float)\n    except Exception as e:\n        errors.append(f\"Error parsing values: {e}\")\n        return False, errors, warnings_list\n    \n    # Check value ranges\n    if (df_copy['x_val'].abs() > 100).any():\n        errors.append(\"Some x values exceed [-100, 100] range\")\n    \n    if (df_copy['y_val'].abs() > 100).any():\n        errors.append(\"Some y values exceed [-100, 100] range\")\n    \n    # Check for expected number of configurations\n    df_copy['n_trees'] = df_copy['id'].str.split('_').str[0].astype(int)\n    unique_n = df_copy['n_trees'].unique()\n    \n    if len(unique_n) != 200:\n        warnings_list.append(f\"Expected 200 configurations, found {l