{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":119106,"databundleVersionId":14485445,"sourceType":"competition"}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# %% [markdown]\n# # Santa 2025 - Christmas Tree Packing Challenge\n# \n# Baseline / analysis notebook.\n# \n# - Loads the competition data (sample submission).\n# - Performs basic EDA on the sample layout.\n# - Engineers useful geometry features (per-puzzle & per-tree).\n# - Defines a baseline \"model\" that reproduces the sample layout.\n# - Computes an approximate objective (using point bounding boxes).\n# - Writes a valid submission file in the required format.\n# \n# This is a safe starting point; later we can swap in better packers.\n\n# %%\nimport os\nimport math\nimport random\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\n# Make plots a bit nicer\nplt.style.use(\"default\")\nplt.rcParams[\"figure.figsize\"] = (6, 4)\nplt.rcParams[\"axes.grid\"] = True\n\nRANDOM_SEED = 42\nrandom.seed(RANDOM_SEED)\nnp.random.seed(RANDOM_SEED)\n\n# %% [markdown]\n# ## 1. Data loading\n# \n# We try a couple of common competition paths.\n# Adjust if needed depending on the exact folder name.\n\n# %%\ndef find_sample_submission():\n    \"\"\"\n    Try to find sample_submission.csv in typical Kaggle competition paths.\n    \"\"\"\n    candidates = [\n        \"/kaggle/input/santa-2025-christmas-tree-packing-challenge/sample_submission.csv\",\n        \"/kaggle/input/santa-2025/sample_submission.csv\",\n        \"/kaggle/input/santa-2025-christmas-tree-packing/sample_submission.csv\",\n    ]\n    for p in candidates:\n        if os.path.exists(p):\n            return p\n    # As a fallback, search under /kaggle/input\n    for root, dirs, files in os.walk(\"/kaggle/input\"):\n        for f in files:\n            if f.lower() == \"sample_submission.csv\":\n                return os.path.join(root, f)\n    raise FileNotFoundError(\"sample_submission.csv not found. Please adjust the path manually.\")\n\nsample_path = find_sample_submission()\nprint(\"Using sample submission from:\", sample_path)\n\nsample_df = pd.read_csv(sample_path)\nsample_df.head()\n\n# %% [markdown]\n# ## 2. Basic EDA on the sample submission\n# \n# We inspect:\n# \n# - Shape and columns\n# - Parsed numeric coordinates and angles\n# - Distribution over n (trees per puzzle)\n# - Coordinate ranges\n# - Approximate bounding-box side per puzzle\n\n# %%\nprint(\"Shape:\", sample_df.shape)\nprint(\"Columns:\", sample_df.columns.tolist())\nsample_df.head()\n\n# %%\n# Parse id into puzzle index (n) and tree index (idx)\ndf = sample_df.copy()\n\ndf[\"n\"] = df[\"id\"].str.split(\"_\").str[0].astype(int)\ndf[\"idx\"] = df[\"id\"].str.split(\"_\").str[1].astype(int)\n\n# Strip leading 's' and convert to float for x, y, deg\nfor col in [\"x\", \"y\", \"deg\"]:\n    df[col + \"_f\"] = df[col].astype(str).str[1:].astype(float)\n\ndf.head()\n\n# %%\n# Quick sanity checks\nprint(\"Number of puzzles (n values):\", df[\"n\"].nunique())\nprint(\"n range:\", df[\"n\"].min(), \"to\", df[\"n\"].max())\n\nprint(\"\\nCoordinate ranges:\")\nprint(\"x:\", df[\"x_f\"].min(), \"to\", df[\"x_f\"].max())\nprint(\"y:\", df[\"y_f\"].min(), \"to\", df[\"y_f\"].max())\n\nprint(\"\\nUnique deg values:\", sorted(df[\"deg_f\"].unique()))\n\n# %%\n# How many trees per puzzle? (Should be sum n = 20100 rows)\nrows_per_n = df.groupby(\"n\")[\"id\"].count().head(10)\nrows_per_n\n\n# %%\n# Check the relationship between puzzle id n and row count\ncheck = df.groupby(\"n\")[\"id\"].count().reset_index(name=\"cnt\")\ncheck[\"expected\"] = check[\"n\"]\ncheck[\"ok\"] = check[\"cnt\"] == check[\"expected\"]\ncheck.head(15)\n\n# %%\n# Plot how the approximate bounding box side (point-based) grows with n\ndef point_bbox_side(grp):\n    \"\"\"Approximate bounding box side using only centers of trees.\"\"\"\n    x_span = grp[\"x_f\"].max() - grp[\"x_f\"].min()\n    y_span = grp[\"y_f\"].max() - grp[\"y_f\"].min()\n    return max(x_span, y_span)\n\nbbox_stats = (\n    df.groupby(\"n\")\n      .apply(point_bbox_side)\n      .reset_index(name=\"side_approx\")\n)\n\nbbox_stats.head()\n\n# %%\nplt.figure()\nplt.plot(bbox_stats[\"n\"], bbox_stats[\"side_approx\"], \".\", markersize=3)\nplt.xlabel(\"n (trees per puzzle)\")\nplt.ylabel(\"Approx. bounding box side (points only)\")\nplt.title(\"Approximate square side vs n (from sample_submission)\")\nplt.show()\n\n# %%\n# Distribution of rotations\nrot_counts = df[\"deg_f\"].value_counts().sort_index()\nrot_counts\n\n# %%\nplt.figure()\nrot_counts.plot(kind=\"bar\")\nplt.xlabel(\"deg\")\nplt.ylabel(\"Count\")\nplt.title(\"Rotation distribution in sample_submission\")\nplt.show()\n\n# %% [markdown]\n# ## 3. Visualising some sample layouts\n# \n# We plot a few puzzles (small/medium/large n) to see how trees are arranged.\n\n# %%\ndef plot_puzzle_layout(puzzle_n, df_parsed, ax=None):\n    grp = df_parsed[df_parsed[\"n\"] == puzzle_n]\n    if ax is None:\n        fig, ax = plt.subplots()\n    ax.scatter(grp[\"x_f\"], grp[\"y_f\"], s=15)\n    for _, row in grp.iterrows():\n        ax.text(row[\"x_f\"], row[\"y_f\"], str(row[\"idx\"]), fontsize=6, ha=\"center\", va=\"center\")\n    ax.set_title(f\"Puzzle n={puzzle_n}, trees={len(grp)}\")\n    ax.set_aspect(\"equal\", \"box\")\n    ax.set_xlabel(\"x\")\n    ax.set_ylabel(\"y\")\n    return ax\n\nexample_ns = [1, 2, 3, 5, 10, 50, 100, 200]\nexample_ns = [n for n in example_ns if n in df[\"n\"].unique()]\n\nfig, axes = plt.subplots(2, 4, figsize=(14, 7))\nfor n_val, ax in zip(example_ns, axes.ravel()):\n    plot_puzzle_layout(n_val, df, ax=ax)\nplt.tight_layout()\nplt.show()\n\n# %% [markdown]\n# ## 4. Feature engineering\n# \n# We prepare:\n# \n# - Per-tree features:\n#   - `r` = radial distance from origin\n#   - `theta` = angle of the center\n# - Per-puzzle features:\n#   - `side_approx` = point-based bounding square side\n#   - `area_approx` = side^2\n#   - `score_term_approx` = side^2 / n (matches structure of competition metric, but using points only)\n\n# %%\n# Per-tree geometric features\ndf[\"r\"] = np.sqrt(df[\"x_f\"]**2 + df[\"y_f\"]**2)\ndf[\"theta\"] = np.degrees(np.arctan2(df[\"y_f\"], df[\"x_f\"]))\n\ndf[[\"id\", \"n\", \"idx\", \"x_f\", \"y_f\", \"r\", \"theta\"]].head()\n\n# %%\n# Per-puzzle bounding info\npuzzle_features = (\n    df.groupby(\"n\")\n      .agg(\n          tree_count=(\"id\", \"count\"),\n          x_min=(\"x_f\", \"min\"),\n          x_max=(\"x_f\", \"max\"),\n          y_min=(\"y_f\", \"min\"),\n          y_max=(\"y_f\", \"max\")\n      )\n      .reset_index()\n)\n\npuzzle_features[\"x_span\"] = puzzle_features[\"x_max\"] - puzzle_features[\"x_min\"]\npuzzle_features[\"y_span\"] = puzzle_features[\"y_max\"] - puzzle_features[\"y_min\"]\npuzzle_features[\"side_approx\"] = puzzle_features[[\"x_span\", \"y_span\"]].max(axis=1)\npuzzle_features[\"area_approx\"] = puzzle_features[\"side_approx\"] ** 2\npuzzle_features[\"score_term_approx\"] = puzzle_features[\"area_approx\"] / puzzle_features[\"n\"]\n\npuzzle_features.head()\n\n# %%\n# Approximate total score (point-based, not official metric)\napprox_total_score = puzzle_features[\"score_term_approx\"].sum()\nprint(\"Approximate total score (from sample_submission, using points only):\", approx_total_score)\n\n# %%\nplt.figure()\nplt.hist(puzzle_features[\"score_term_approx\"], bins=30)\nplt.xlabel(\"Approx. score term (side^2 / n)\")\nplt.ylabel(\"Count of puzzles\")\nplt.title(\"Distribution of approximate score term across puzzles\")\nplt.show()\n\n# %% [markdown]\n# ## 5. Baseline model / heuristic\n# \n# The competition is a **pure geometry / packing** problem, not a supervised ML task.\n# \n# As a safe baseline:\n# \n# - We keep the sample submission layout as-is.\n# - We do **not** try to shrink or move trees yet (no collision detection implemented here).\n# - We wrap this in a `baseline_layout` function so we can swap in improved heuristics later.\n\n# %%\ndef baseline_layout_from_sample(df_parsed):\n    \"\"\"\n    Baseline: return the same layout as the sample submission, but\n    with numeric columns (x_f, y_f, deg_f) already parsed.\n    \n    Returns a DataFrame with:\n        id, x, y, deg  (numeric versions: x_f, y_f, deg_f)\n    \"\"\"\n    cols = [\"id\", \"n\", \"idx\", \"x_f\", \"y_f\", \"deg_f\"]\n    layout_df = df_parsed[cols].copy()\n    return layout_df\n\nbaseline_layout = baseline_layout_from_sample(df)\nbaseline_layout.head()\n\n# %% [markdown]\n# ## 6. Evaluation of the baseline layout (approximate)\n# \n# Using the numeric layout from our baseline, we recompute:\n# \n# - Approximate bounding box side per puzzle.\n# - Approximate `side^2 / n`.\n# - Overall approximate metric.\n\n# %%\ndef compute_point_based_metrics(layout_df):\n    # layout_df must contain columns: n, x_f, y_f\n    puzzle = (\n        layout_df.groupby(\"n\")\n        .agg(\n            x_min=(\"x_f\", \"min\"),\n            x_max=(\"x_f\", \"max\"),\n            y_min=(\"y_f\", \"min\"),\n            y_max=(\"y_f\", \"max\"),\n            tree_count=(\"id\", \"count\")\n        )\n        .reset_index()\n    )\n    puzzle[\"x_span\"] = puzzle[\"x_max\"] - puzzle[\"x_min\"]\n    puzzle[\"y_span\"] = puzzle[\"y_max\"] - puzzle[\"y_min\"]\n    puzzle[\"side_approx\"] = puzzle[[\"x_span\", \"y_span\"]].max(axis=1)\n    puzzle[\"area_approx\"] = puzzle[\"side_approx\"] ** 2\n    puzzle[\"score_term_approx\"] = puzzle[\"area_approx\"] / puzzle[\"n\"]\n    total_score = puzzle[\"score_term_approx\"].sum()\n    return puzzle, total_score\n\nbaseline_puzzle_metrics, baseline_approx_score = compute_point_based_metrics(baseline_layout)\nprint(\"Baseline approx score (point-based):\", baseline_approx_score)\nbaseline_puzzle_metrics.head()\n\n# %% [markdown]\n# ## 7. Generate submission file\n# \n# - We start from our baseline numeric layout.\n# - We re-create `x`, `y`, `deg` with leading `'s'`.\n# - We save as `submission.csv` in the working directory.\n\n# %%\ndef make_submission_from_layout(layout_df, filename=\"submission.csv\", decimals=6):\n    \"\"\"\n    layout_df: columns must include id, x_f, y_f, deg_f\n    \"\"\"\n    sub = pd.DataFrame()\n    sub[\"id\"] = layout_df[\"id\"].astype(str)\n    \n    fmt = f\"{{:.{decimals}f}}\".format\n    \n    sub[\"x\"] = layout_df[\"x_f\"].apply(lambda v: \"s\" + fmt(v))\n    sub[\"y\"] = layout_df[\"y_f\"].apply(lambda v: \"s\" + fmt(v))\n    sub[\"deg\"] = layout_df[\"deg_f\"].apply(lambda v: \"s\" + fmt(v))\n    \n    sub.to_csv(filename, index=False)\n    return sub\n\nsubmission_df = make_submission_from_layout(baseline_layout, filename=\"submission.csv\")\nsubmission_df.head()\n\n# %%\nprint(\"Saved submission.csv with shape:\", submission_df.shape)\n\n# %% [markdown]\n# ## 8. Optional: consistency check vs original sample\n# \n# If the formatting (number of decimals) matches the original, this\n# difference should be zero rows. If decimals differ, differences may appear\n# only in `x`, `y`, `deg` string formatting, not in the numeric layout.\n\n# %%\n# Rebuild \"original style\" columns from our numeric values with 1 decimal place,\n# which is what the uploaded sample seems to use for many entries.\nsub_1dec = make_submission_from_layout(baseline_layout, filename=\"submission_1dec.csv\", decimals=1)\n\n# Compare with original sample file\n# (This only works if the original uses exactly the same formatting.)\nmerged = sample_df.merge(sub_1dec, on=\"id\", suffixes=(\"_orig\", \"_new\"))\ndiff_mask = (merged[\"x_orig\"] != merged[\"x_new\"]) | (merged[\"y_orig\"] != merged[\"y_new\"]) | (merged[\"deg_orig\"] != merged[\"deg_new\"])\nnum_diffs = diff_mask.sum()\n\nprint(\"Number of rows where (x,y,deg) differ from original sample formatting:\", num_diffs)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-18T16:16:40.406136Z","iopub.execute_input":"2025-11-18T16:16:40.406466Z","iopub.status.idle":"2025-11-18T16:16:44.476760Z","shell.execute_reply.started":"2025-11-18T16:16:40.406444Z","shell.execute_reply":"2025-11-18T16:16:44.475620Z"}},"outputs":[{"name":"stdout","text":"Using sample submission from: /kaggle/input/santa-2025/sample_submission.csv\nShape: (20100, 4)\nColumns: ['id', 'x', 'y', 'deg']\nNumber of puzzles (n values): 200\nn range: 1 to 200\n\nCoordinate ranges:\nx: -5.798383 to 5.289256\ny: -5.635722 to 5.798748\n\nUnique deg values: [0.0, 90.0, 180.0, 270.0]\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_48/2171367748.py:128: DeprecationWarning: DataFrameGroupBy.apply operated on the grouping columns. This behavior is deprecated, and in a future version of pandas the grouping columns will be excluded from the operation. Either pass `include_groups=False` to exclude the groupings or explicitly select the grouping columns after groupby to silence this warning.\n  .apply(point_bbox_side)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x700 with 8 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Approximate total score (from sample_submission, using points only): 114.0915313714668\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata