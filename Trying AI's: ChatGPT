{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":119106,"databundleVersionId":14485445,"sourceType":"competition"}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# Cell 1: Imports & basic settings\n\nimport math\nimport random\nfrom decimal import Decimal, getcontext\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\nimport shapely\nfrom shapely import affinity\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\nfrom shapely.strtree import STRtree\n\nprint(f\"Using shapely {shapely.__version__}\")\n\npd.set_option('display.float_format', '{:.12f}'.format)\n\n# Reproducibility\nRANDOM_SEED = 42\nrandom.seed(RANDOM_SEED)\nnp.random.seed(RANDOM_SEED)\n\n\n\n# Cell 2: Decimal precision, scaling, and index\n\n# Precision for Decimal operations\ngetcontext().prec = 25\n\n# Geometries are scaled up by 1e15 to reduce floating point issues, just like the starter notebook\nscale_factor = Decimal('1e15')\n\n# Build the submission index: 'nnn_i' for n = 1..200 and i = 0..n-1\nindex = [f'{n:03d}_{t}' for n in range(1, 201) for t in range(n)]\nlen(index)\n\n\n\n# Cell 3: ChristmasTree geometry\n\nclass ChristmasTree:\n    \"\"\"Represents a single, rotatable Christmas tree of a fixed size.\"\"\"\n\n    def __init__(self, center_x='0', center_y='0', angle='0'):\n        \"\"\"\n        center_x, center_y, angle are strings/Decimals in 'tree units' (not scaled yet).\n        Polygon is created in scaled coordinates (multiplied by 1e15).\n        \"\"\"\n        self.center_x = Decimal(center_x)\n        self.center_y = Decimal(center_y)\n        self.angle = Decimal(angle)\n\n        trunk_w = Decimal('0.15')\n        trunk_h = Decimal('0.2')\n        base_w = Decimal('0.7')\n        mid_w = Decimal('0.4')\n        top_w = Decimal('0.25')\n        tip_y = Decimal('0.8')\n        tier_1_y = Decimal('0.5')\n        tier_2_y = Decimal('0.25')\n        base_y = Decimal('0.0')\n        trunk_bottom_y = -trunk_h\n\n        # Base polygon centered at (0, 0), pointing \"up\"\n        initial_polygon = Polygon(\n            [\n                # Tip\n                (Decimal('0.0') * scale_factor, tip_y * scale_factor),\n                # Right side - Top Tier\n                (top_w / Decimal('2') * scale_factor, tier_1_y * scale_factor),\n                (top_w / Decimal('4') * scale_factor, tier_1_y * scale_factor),\n                # Right side - Middle Tier\n                (mid_w / Decimal('2') * scale_factor, tier_2_y * scale_factor),\n                (mid_w / Decimal('4') * scale_factor, tier_2_y * scale_factor),\n                # Right side - Bottom Tier\n                (base_w / Decimal('2') * scale_factor, base_y * scale_factor),\n                # Right Trunk\n                (trunk_w / Decimal('2') * scale_factor, base_y * scale_factor),\n                (trunk_w / Decimal('2') * scale_factor, trunk_bottom_y * scale_factor),\n                # Left Trunk\n                (-(trunk_w / Decimal('2')) * scale_factor, trunk_bottom_y * scale_factor),\n                (-(trunk_w / Decimal('2')) * scale_factor, base_y * scale_factor),\n                # Left side - Bottom Tier\n                (-(base_w / Decimal('2')) * scale_factor, base_y * scale_factor),\n                # Left side - Middle Tier\n                (-(mid_w / Decimal('4')) * scale_factor, tier_2_y * scale_factor),\n                (-(mid_w / Decimal('2')) * scale_factor, tier_2_y * scale_factor),\n                # Left side - Top Tier\n                (-(top_w / Decimal('4')) * scale_factor, tier_1_y * scale_factor),\n                (-(top_w / Decimal('2')) * scale_factor, tier_1_y * scale_factor),\n            ]\n        )\n\n        # Rotate and translate to the desired position and angle\n        rotated = affinity.rotate(initial_polygon, float(self.angle), origin=(0, 0))\n        self.polygon = affinity.translate(\n            rotated,\n            xoff=float(self.center_x * scale_factor),\n            yoff=float(self.center_y * scale_factor),\n        )\n\n\n\n\n# Cell 4: Angle generator and collision helper\n\ndef generate_weighted_angle():\n    \"\"\"\n    Generates a random angle (radians) with distribution weighted by abs(sin(2*angle)).\n    This biases directions towards the diagonal-ish directions, helping create less round packings.\n    \"\"\"\n    while True:\n        angle = random.uniform(0, 2 * math.pi)\n        if random.uniform(0, 1) < abs(math.sin(2 * angle)):\n            return angle\n\ndef has_collision(candidate_poly, placed_polygons, tree_index):\n    \"\"\"\n    Check if candidate_poly overlaps with any polygon in placed_polygons (using STRtree).\n    Touching (boundary contact only) is allowed; actual intersection is not.\n    \"\"\"\n    if not placed_polygons:\n        return False\n\n    possible_indices = tree_index.query(candidate_poly)\n    for i in possible_indices:\n        poly = placed_polygons[i]\n        if candidate_poly.intersects(poly) and not candidate_poly.touches(poly):\n            return True\n    return False\n\n\n\n\n# Cell 5: Bounding square computation\n\ndef compute_side_length(placed_trees):\n    \"\"\"\n    Given a list of ChristmasTree objects, compute the side length of the\n    smallest axis-aligned square that bounds all of them.\n    \"\"\"\n    if not placed_trees:\n        return Decimal('0')\n\n    all_polygons = [t.polygon for t in placed_trees]\n    bounds = unary_union(all_polygons).bounds  # (minx, miny, maxx, maxy)\n\n    minx = Decimal(bounds[0]) / scale_factor\n    miny = Decimal(bounds[1]) / scale_factor\n    maxx = Decimal(bounds[2]) / scale_factor\n    maxy = Decimal(bounds[3]) / scale_factor\n\n    width = maxx - minx\n    height = maxy - miny\n    side_length = max(width, height)\n\n    return side_length\n\n\n\n\n# Cell 6: Plotting helper (optional visualization)\n\nfrom matplotlib.patches import Rectangle\n\ndef plot_results(side_length, placed_trees, num_trees, show=True):\n    \"\"\"Plots the arrangement of trees and the bounding square.\"\"\"\n    fig, ax = plt.subplots(figsize=(6, 6))\n    colors = plt.cm.viridis([i / max(num_trees - 1, 1) for i in range(num_trees)])\n\n    all_polygons = [t.polygon for t in placed_trees]\n    bounds = unary_union(all_polygons).bounds\n\n    for i, tree in enumerate(placed_trees):\n        x_scaled, y_scaled = tree.polygon.exterior.xy\n        x = [Decimal(val) / scale_factor for val in x_scaled]\n        y = [Decimal(val) / scale_factor for val in y_scaled]\n        ax.fill(x, y, alpha=0.6, color=colors[i])\n        ax.plot(x, y, color=colors[i])\n\n    minx = Decimal(bounds[0]) / scale_factor\n    miny = Decimal(bounds[1]) / scale_factor\n    maxx = Decimal(bounds[2]) / scale_factor\n    maxy = Decimal(bounds[3]) / scale_factor\n\n    width = maxx - minx\n    height = maxy - miny\n\n    square_x = minx if width >= height else minx - (side_length - width) / 2\n    square_y = miny if height >= width else miny - (side_length - height) / 2\n\n    bounding_square = Rectangle(\n        (float(square_x), float(square_y)),\n        float(side_length),\n        float(side_length),\n        fill=False,\n        edgecolor='red',\n        linewidth=2,\n        linestyle='--',\n    )\n    ax.add_patch(bounding_square)\n\n    padding = Decimal('0.5')\n    ax.set_xlim(\n        float(square_x - padding),\n        float(square_x + side_length + padding),\n    )\n    ax.set_ylim(\n        float(square_y - padding),\n        float(square_y + side_length + padding),\n    )\n    ax.set_aspect('equal', adjustable='box')\n    ax.axis('off')\n    ax.set_title(f'{num_trees} Trees: side={side_length:.6f}')\n    if show:\n        plt.show()\n    plt.close(fig)\n\n\n\n\n# Cell 7: Improved greedy packer for a given n\n\ndef build_configuration_for_n(\n    num_trees: int,\n    num_attempts_per_tree: int = 20,\n    start_radius: Decimal = Decimal('15.0'),\n    step_in: Decimal = Decimal('0.3'),\n    step_out: Decimal = Decimal('0.03'),\n) -> tuple[list, Decimal]:\n    \"\"\"\n    Build a configuration of `num_trees` trees using a greedy inward placement algorithm.\n\n    Improvements over starter notebook:\n      - Each n is optimized independently (no prefix constraint from n=200).\n      - More attempts per tree and finer step sizes for tighter packing.\n\n    Returns:\n      placed_trees: list[ChristmasTree]\n      side_length: Decimal (side length of bounding square)\n    \"\"\"\n    if num_trees <= 0:\n        return [], Decimal('0')\n\n    placed_trees = []\n\n    # Pre-create all trees with random rotations\n    all_trees = [ChristmasTree(angle=str(random.uniform(0, 360))) for _ in range(num_trees)]\n\n    # Place the first tree at the origin\n    placed_trees.append(all_trees[0])\n\n    # Place remaining trees greedily\n    for tree_to_place in all_trees[1:]:\n        placed_polygons = [t.polygon for t in placed_trees]\n        tree_index = STRtree(placed_polygons)\n\n        best_px = None\n        best_py = None\n        min_radius = Decimal('Infinity')\n\n        for _ in range(num_attempts_per_tree):\n            # Random direction (biased)\n            angle_rad = generate_weighted_angle()\n            vx = Decimal(str(math.cos(angle_rad)))\n            vy = Decimal(str(math.sin(angle_rad)))\n\n            radius = start_radius\n            collision_found = False\n\n            # Move towards center until collision\n            while radius >= 0:\n                px = radius * vx\n                py = radius * vy\n\n                candidate_poly = affinity.translate(\n                    tree_to_place.polygon,\n                    xoff=float(px * scale_factor),\n                    yoff=float(py * scale_factor),\n                )\n\n                if has_collision(candidate_poly, placed_polygons, tree_index):\n                    collision_found = True\n                    break\n\n                radius -= step_in\n\n            # Back out slightly, to the last non-colliding position\n            if collision_found:\n                while True:\n                    radius += step_out\n                    px = radius * vx\n                    py = radius * vy\n                    candidate_poly = affinity.translate(\n                        tree_to_place.polygon,\n                        xoff=float(px * scale_factor),\n                        yoff=float(py * scale_factor),\n                    )\n                    if not has_collision(candidate_poly, placed_polygons, tree_index):\n                        break\n            else:\n                # No collision even at center, just drop it at center\n                radius = Decimal('0')\n                px = Decimal('0')\n                py = Decimal('0')\n\n            if radius < min_radius:\n                min_radius = radius\n                best_px = px\n                best_py = py\n\n        # Commit the best position found for this tree\n        tree_to_place.center_x = best_px\n        tree_to_place.center_y = best_py\n        tree_to_place.polygon = affinity.translate(\n            tree_to_place.polygon,\n            xoff=float(tree_to_place.center_x * scale_factor),\n            yoff=float(tree_to_place.center_y * scale_factor),\n        )\n        placed_trees.append(tree_to_place)\n\n    # Compute bounding square side length\n    side_length = compute_side_length(placed_trees)\n    return placed_trees, side_length\n\n\n\n\n\n# Cell 8: Sanity check on a few small n with plotting\n\ntest_ns = [1, 5, 10, 20]\n\nfor n in test_ns:\n    trees_n, side_n = build_configuration_for_n(n)\n    print(f\"n={n}, side={side_n:.6f}\")\n    plot_results(side_n, trees_n, n, show=True)\n\n\n\n\n# Cell 9: Generate configurations for all n = 1..200\n\nall_tree_data = []   # list of [x, y, deg] rows matching `index`\nside_lengths = []    # for logging / debugging\n\nfor n in range(1, 201):\n    placed_trees, side_n = build_configuration_for_n(\n        num_trees=n,\n        num_attempts_per_tree=20,\n        start_radius=Decimal('15.0'),\n        step_in=Decimal('0.3'),\n        step_out=Decimal('0.03'),\n    )\n    side_lengths.append(float(side_n))\n    # Append tree data in order 0..n-1 for this n\n    for tree in placed_trees:\n        all_tree_data.append([tree.center_x, tree.center_y, tree.angle])\n\n    if n % 20 == 0:\n        print(f\"Finished n={n}, side={side_n:.6f}\")\n\nlen(all_tree_data), len(index)\n\n\n\n\n# Cell 10: Build submission DataFrame and save to CSV\n\ncols = ['x', 'y', 'deg']\nsubmission = pd.DataFrame(index=index, columns=cols, data=all_tree_data).rename_axis('id')\n\n# Convert Decimals to float and round a bit (Kaggle metric is robust to minor rounding)\nfor col in cols:\n    submission[col] = submission[col].astype(float).round(6)\n\n# Make sure x, y stay within [-100, 100] (they should, but clip just in case)\nsubmission['x'] = submission['x'].clip(-100, 100)\nsubmission['y'] = submission['y'].clip(-100, 100)\n\n# Prepend 's' to each value\nfor col in cols:\n    submission[col] = 's' + submission[col].astype('string')\n\nsubmission.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-25T09:57:24.684279Z","iopub.execute_input":"2025-11-25T09:57:24.684586Z","iopub.status.idle":"2025-11-25T10:21:46.664587Z","shell.execute_reply.started":"2025-11-25T09:57:24.684562Z","shell.execute_reply":"2025-11-25T10:21:46.663618Z"}},"outputs":[{"name":"stdout","text":"Using shapely 2.1.2\nn=1, side=0.838638\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 